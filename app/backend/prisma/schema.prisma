// Bergwacht Getränkekasse — Schema
// Beträge in Cent (Int), negativ erlaubt — KEIN CHECK-Constraint.
// Guthaben wird live aus Transaktionen summiert (KONFIGURATION.md §6.1),
// kein gespeichertes Feld am User („cannot be wrong by design").

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// isLeitung: read-only Kassen-Einsicht (Spec §4). Schema seit B2e.1, Logik B2j.
// paypalMeLink: paypal.me-URL des Verwalters. Schema seit B2e.1, Logik B2k
// (Multi-Verwalter-Verteilung). Bei Nicht-Admins irrelevant.
// whatsappNummer: WhatsApp-Nummer des Verwalters (internationales Format, nur
// Ziffern, z.B. „491701234567") für die Member-Benachrichtigung via wa.me beim
// PayPal-Umbau. Optional, nur bei Admins relevant.
model User {
  id             String   @id @default(cuid())
  email          String   @unique
  firstName      String
  lastName       String
  passwordHash   String?  // null bis Magic-Link eingelöst
  isAdmin        Boolean  @default(false)
  isLeitung      Boolean  @default(false)
  paypalMeLink   String?
  whatsappNummer String?
  isActive       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  invites                            Invite[]
  sessions                           Session[]
  transaktionen                      Transaktion[]       @relation("UserTransaktionen")
  erstellteTransaktionen             Transaktion[]       @relation("ErstellerTransaktionen")
  kassenTransaktionenAlsVerwalter    KassenTransaktion[] @relation("VerwalterKassenTransaktionen")
  erstellteKassenTransaktionen       KassenTransaktion[] @relation("ErstellerKassenTransaktionen")
  aufladungsAnfragen                 AufladungsAnfrage[] @relation("UserAufladungsAnfragen")
  zugewieseneAufladungsAnfragen      AufladungsAnfrage[] @relation("ZugewieseneAufladungsAnfragen")
  entschiedeneAufladungsAnfragen     AufladungsAnfrage[] @relation("EntschiedeneAufladungsAnfragen")
  gameScores                         GameScore[]
}

model Invite {
  id         String    @id @default(cuid())
  tokenHash  String    @unique // SHA-256 des Klartext-Tokens
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  redeemedAt DateTime?

  @@index([userId])
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  @@index([userId])
}

// Drink-Katalog (Phase B2b). preisCent in Cent als Int.
// kategorie: 'alkoholfrei' | 'alkoholisch' | 'sonstiges' — feste Liste,
// validiert via src/domain/drink-kategorien.ts (Prisma-Enums sind auf SQLite nicht unterstützt).
// Soft-Disable über isActive — Hard-Delete würde künftige Transaktions-Referenzen brechen.
model Drink {
  id         String   @id @default(cuid())
  name       String
  preisCent  Int
  icon       String?
  kategorie  String
  marke      String?  // optionale Marke/Brauerei, z.B. „Coca-Cola", „Augustiner"
  volumenMl  Int?     // optionale Gebindegröße in Millilitern, z.B. 500, 330, 200
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  transaktionen Transaktion[]
}

// Mitglieder-Ebene (KONFIGURATION.md §5.3). Audit-Trail — niemals löschen.
// typ: KAUF | AUFLADUNG_PAYPAL | AUFLADUNG_BARGELD | KORREKTUR | STORNO,
// validiert via src/domain/transaktion-typ.ts.
// betragCent: negativ bei KAUF, positiv bei Aufladung. preisAtKaufCent friert
// den Drink-Preis bei KAUF ein — spätere Preisänderungen am Drink ändern keine
// historischen Buchungen. stornoVonId verweist (B2d) auf die stornierte
// Ursprungs-Transaktion. erstelltVonId = wer hat sie ausgelöst (bei
// Selbstbuchung = userId selbst, bei Admin-Aktion = der Admin).
// kassenTransaktionId koppelt eine Aufladung an die Kassen-Einzahlung
// (seit B2e.1) — bei KAUF/KORREKTUR/STORNO bleibt das Feld null.
model Transaktion {
  id                  String             @id @default(cuid())
  userId              String
  user                User               @relation("UserTransaktionen", fields: [userId], references: [id], onDelete: Cascade)
  typ                 String
  betragCent          Int
  drinkId             String?
  drink               Drink?             @relation(fields: [drinkId], references: [id])
  preisAtKaufCent     Int?
  stornoVonId         String?            @unique
  stornoVon           Transaktion?       @relation("StornoVerweis", fields: [stornoVonId], references: [id])
  stornoDurch         Transaktion?       @relation("StornoVerweis")
  notiz               String?
  erstelltVonId       String
  erstelltVon         User               @relation("ErstellerTransaktionen", fields: [erstelltVonId], references: [id])
  kassenTransaktionId String?            @unique
  kassenTransaktion   KassenTransaktion? @relation("MitgliedKassenKopplung", fields: [kassenTransaktionId], references: [id])
  aufladungsAnfrage   AufladungsAnfrage? @relation("AnfrageTransaktion")
  createdAt           DateTime           @default(now())

  @@index([userId])
  @@index([drinkId])
  @@index([erstelltVonId])
}

// Kassen-Ebene (KONFIGURATION.md §5.6). Audit-Trail — niemals löschen.
// typ: EINZAHLUNG | EINLAGE_BOX | EINKAUF | ENTNAHME | SPENDE | KORREKTUR,
// konto: VERWALTER | BOX — validiert via src/domain/kassen-typ.ts + kassen-konto.ts.
// verwalterId: gesetzt bei konto=VERWALTER (welcher Topf), null bei konto=BOX.
// notiz: PFLICHT bei JEDER Bewegung (§6.8) — die Spalte ist NOT NULL, weil
// String ohne `?` in Prisma required ist.
// transaktionId: gekoppelte Mitglieder-Aufladung (bei EINZAHLUNG), sonst null.
// einlageGegenId: bei EINLAGE_BOX die Gegenbuchung (reflexiv), sonst null.
// In B2e nur die EINZAHLUNG/VERWALTER-Schreibseite + KORREKTUR-Gegenbuchung
// für Storno; die anderen Typen + BOX kommen ohne Migration in B2i.
model KassenTransaktion {
  id              String             @id @default(cuid())
  typ             String
  konto           String
  verwalterId     String?
  verwalter       User?              @relation("VerwalterKassenTransaktionen", fields: [verwalterId], references: [id])
  betragCent      Int
  notiz           String
  transaktionId   String?            @unique
  transaktion     Transaktion?       @relation("MitgliedKassenKopplung")
  einlageGegenId  String?            @unique
  einlageGegen    KassenTransaktion? @relation("EinlageGegen", fields: [einlageGegenId], references: [id])
  einlageDurch    KassenTransaktion? @relation("EinlageGegen")
  erstelltVonId   String
  erstelltVon     User               @relation("ErstellerKassenTransaktionen", fields: [erstelltVonId], references: [id])
  createdAt       DateTime           @default(now())

  @@index([verwalterId])
  @@index([erstelltVonId])
  @@index([konto])
}

// PayPal-Aufladungs-Anfrage (KONFIGURATION.md §5.5, §6.5). State-Machine:
// OFFEN → BESTAETIGT (gekoppelte Mitglieder- + Kassen-Buchung) | ABGELEHNT.
// status als String + Zod (src/domain/aufladungs-status.ts), weil SQLite keine
// Prisma-Enums kann.
// zugewiesenerVerwalterId: der beim Abschicken zuständige Verwalter (in B2f
// schlicht der/ein Admin; die echte Lastverteilung nach geringster Schuld kommt
// in B2k — §6.9). Nur DIESER Verwalter bestätigt später seine Anfrage.
// decidedById/decidedAt/adminNotiz: gesetzt bei Entscheidung (Ablehnen-Notiz
// optional). transaktionId koppelt bei BESTAETIGT die erzeugte AUFLADUNG_PAYPAL-
// Transaktion (1-1) — über die hängt via Transaktion.kassenTransaktionId auch
// die Kassen-EINZAHLUNG dran.
// betragCent: NULL bei der betraglosen Anfrage (PayPal-Umbau) — das Mitglied
// überweist selbst einen frei gewählten Betrag. Beim Bestätigen setzt der
// zuständige Verwalter die tatsächlich überwiesene Summe (Int > 0), die dann
// gebucht und hier zur Doku gespeichert wird.
model AufladungsAnfrage {
  id                      String       @id @default(cuid())
  userId                  String
  user                    User         @relation("UserAufladungsAnfragen", fields: [userId], references: [id], onDelete: Cascade)
  betragCent              Int?
  status                  String       @default("OFFEN")
  zugewiesenerVerwalterId String
  zugewiesenerVerwalter   User         @relation("ZugewieseneAufladungsAnfragen", fields: [zugewiesenerVerwalterId], references: [id])
  requestedAt             DateTime     @default(now())
  decidedAt               DateTime?
  decidedById             String?
  decidedBy               User?        @relation("EntschiedeneAufladungsAnfragen", fields: [decidedById], references: [id])
  adminNotiz              String?
  transaktionId           String?      @unique
  transaktion             Transaktion? @relation("AnfrageTransaktion", fields: [transaktionId], references: [id])

  @@index([userId])
  @@index([zugewiesenerVerwalterId])
  @@index([decidedById])
  @@index([status])
}

// GameScore — Bestenliste fürs Bergwacht-Alpinist-Spiel (Phase B_GAME_ALPINIST).
// Additive Tabelle, kein Bezug zur Geschäftslogik. Ein Eintrag pro abgeschlossenem
// Lauf (Sieg). score = Basis (Collectibles + besiegte Gegner) + Höhenbonus.
model GameScore {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  level             Int      @default(1)
  score             Int
  timeMs            Int
  collectiblesFound Int      @default(0)
  enemiesDefeated   Int      @default(0)
  livesLost         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId])
  @@index([createdAt])
}
