# Backend — Production (B8). Vorlage: beim Deploy nach `backend/.env` kopieren
# und JWT_SECRET durch einen echten Zufallswert ersetzen. Diese Datei enthält
# KEINE Geheimnisse (nur Platzhalter) und ist daher im Repo.

NODE_ENV=production

# Ein Dienst, ein Port. 3002, weil 3000/3001 auf dem Server belegt sind.
PORT=3002

# SQLite bleibt auch in Prod. Pfad ist RELATIV zu schema.prisma (backend/prisma/),
# nicht zur WorkingDirectory → landet unter backend/prisma/data/getraenke.db.
# Erst-Bootstrap per `prisma db push` + `seed` (siehe DEPLOY.md).
DATABASE_URL="file:./data/getraenke.db"

# PFLICHT beim Deploy ersetzen, z.B.: openssl rand -base64 48
JWT_SECRET="REPLACE_ME_BEIM_DEPLOY_openssl_rand_base64_48"

# Öffentliche Basis-URL (für Invite-/Magic-Links in den Mail-Texten).
APP_BASE_URL="https://getraenke.einfall.app"

# FRONTEND_ORIGIN wird in Prod NICHT gebraucht (same-origin, CORS ist aus). Der
# Zod-Default (http://localhost:3001) greift und stört nicht. Bei Bedarf auf die
# Domain setzen: FRONTEND_ORIGIN="https://getraenke.einfall.app"
